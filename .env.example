# PostgreSQL connection string (Neon, Supabase, Railway, Render, RDS, local, etc.)
# For Vercel/serverless Postgres, use the pooled connection string.
DATABASE_URL="postgresql://user:password@host:5432/feedback_bot?schema=public"

# Secret token for protecting /api/admin/* routes and the admin dashboard login.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN="change-me-to-a-long-random-string"

# Requests allowed per API key per minute on POST /api/v1/feedback
RATE_LIMIT_PER_MINUTE=10

# Default Discord webhook URLs (used if an app doesn't configure its own per-type webhook)
DISCORD_BUG_WEBHOOK_URL=""
DISCORD_FEEDBACK_WEBHOOK_URL=""
DISCORD_FEATURE_WEBHOOK_URL=""

NODE_ENV="development"
